# Copy this to .env and fill in real keys.

# Which model answers as the tutor: anthropic | openai | gemini
# You only need the key for the provider you pick.
# Gemini has a free tier and needs no card: https://aistudio.google.com/apikey
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

ELEVENLABS_API_KEY=

# Needed for mic input (Whisper STT) whichever tutor provider you choose,
# and reused as the tutor if LLM_PROVIDER=openai.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Model names move — check the provider's current list if a call 404s.
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3.8-flash

# A warm Turkish-capable voice. Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# CORS — the frontend dev origin.
FRONTEND_ORIGIN=http://localhost:3000