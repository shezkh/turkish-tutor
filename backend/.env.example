# Copy this to .env and fill in real keys.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# For mic input (Whisper STT). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional — defaults are sensible.
CLAUDE_MODEL=claude-sonnet-4-5

# A warm Turkish-capable voice. Browse voices at https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# CORS — the frontend dev origin.
FRONTEND_ORIGIN=http://localhost:3000