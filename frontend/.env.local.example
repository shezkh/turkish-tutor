# Copy this to .env.local and adjust if needed.

# By default we look for the avatar GLB at /public/avatar-vroid.glb — an
# official VRoid Studio sample character (AvatarSample_C from VRoid Hub,
# redistribution/commercial-use licensed), already included in the repo.
#
# To use a different avatar, drop a .glb/.vrm into frontend/public/ and
# point this at it — or host it elsewhere (CDN, S3) and put the full URL
# here instead. Avatar.tsx matches either ARKit blendshape names (jawOpen,
# mouthClose, eyeBlinkLeft/Right, ...) or VRoid's native names
# (Fcl_MTH_A, Fcl_EYE_Close), whichever the file has. Double-check the new
# avatar's license actually permits redistribution before swapping it in.
NEXT_PUBLIC_AVATAR_URL=/avatar-vroid.glb

# Backend URL.
NEXT_PUBLIC_API_BASE=http://localhost:8000
